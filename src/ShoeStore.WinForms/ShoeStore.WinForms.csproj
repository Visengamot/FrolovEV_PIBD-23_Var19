<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.1.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Forms\MainForm.cs;Forms\ManufacturersForm.cs;Forms\ShoesForm.cs;Forms\ShoeSizesForm.cs;Forms\ManufacturerEditorForm.cs;Forms\ShoeEditorForm.cs;Forms\ShoeSizeEditorForm.cs;Forms\MovementsForm.cs;Forms\InventoryForm.cs;Forms\MovementEditorForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\*.Designer.cs">
      <DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Designer', '')).cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\*.resx">
      <DependentUpon>%(Filename).cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
